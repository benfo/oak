<dialog id="screenshot-viewer" class="modal" aria-labelledby="screenshot-title" aria-describedby="screenshot-help">
  <div class="modal-box flex max-h-[94dvh] w-[96vw] max-w-none flex-col gap-4 rounded-lg p-4">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <h2 id="screenshot-title" class="text-sm font-medium"></h2>
        <p id="screenshot-help" class="mt-1 text-xs text-base-content/60">Scroll to read the full screenshot.</p>
      </div>
      <form method="dialog"><button class="btn btn-sm shrink-0" autofocus>Close</button></form>
    </div>
    <div class="min-h-0 overflow-auto rounded-md border border-base-300" tabindex="0" role="region" aria-label="Full screenshot">
      <img id="screenshot-image" alt="" class="block h-auto w-full min-w-[64rem]" />
    </div>
    <a id="screenshot-original" class="link link-primary self-start text-sm" target="_blank" rel="noopener">Open original image in a new tab</a>
  </div>
  <form method="dialog" class="modal-backdrop"><button aria-label="Close screenshot" tabindex="-1">Close</button></form>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#screenshot-viewer')!
  const image = document.querySelector<HTMLImageElement>('#screenshot-image')!
  const title = document.querySelector<HTMLElement>('#screenshot-title')!
  const original = document.querySelector<HTMLAnchorElement>('#screenshot-original')!

  document.querySelectorAll<HTMLAnchorElement>('[data-screenshot]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return
      event.preventDefault()
      const thumbnail = link.querySelector('img')!
      image.src = link.href
      image.alt = thumbnail.alt
      title.textContent = thumbnail.alt
      original.href = link.href
      link.focus({ preventScroll: true })
      dialog.showModal()
      const scroller = image.parentElement!
      scroller.scrollTop = 0
      scroller.scrollLeft = 0
    })
  })
</script>
