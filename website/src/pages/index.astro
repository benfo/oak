---
import '@fontsource-variable/hanken-grotesk'
import '../styles/site.css'
import ThemeInit from '../components/ThemeInit.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import SystemMap from '../components/SystemMap.astro'
import ScreenshotViewer from '../components/ScreenshotViewer.astro'
import { planned } from '../data/lines'
import { version } from '../data/release.json'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const download = 'https://github.com/benfo/oak/releases/latest'
const description = 'Oak is a cross-platform Git client. Browse history, compare branches, read diffs and stage files, hunks or selected lines. Search for actions in the command palette.'
const plannedRows = [planned.slice(0, 4), planned.slice(4)]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <ThemeInit />
    <link rel="canonical" href={new URL(base + '/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/icon.svg`} />
    <meta property="og:title" content="Oak: Cross-platform Git client" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(base + '/', Astro.site)} />
    <meta property="og:image" content={new URL(base + '/oak-comparison-dark.png', Astro.site)} />
    <meta property="og:image:alt" content="Oak comparing a feature branch with main in a synthetic project." />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Oak: Cross-platform Git client</title>
  </head>
  <body>
    <a class="btn btn-primary fixed top-2 left-2 z-50 -translate-y-24 focus:translate-y-0" href="#main">Skip to content</a>
    <header class="site-shell">
      <div class="navbar min-h-20 px-0">
        <a class="oak-wordmark" href={`${base}/`} aria-label="Oak home"><img src={`${base}/icon.svg`} width="32" height="32" alt="" /><span>oak</span></a>
        <nav class="ml-auto flex items-center gap-2 sm:gap-6" aria-label="Main navigation">
          <a class="nav-link hidden sm:inline" href="#map">Features</a>
          <a class="nav-link hidden sm:inline" href="#planned">Planned</a>
          <a class="nav-link" href="#download">Download</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="site-shell pt-8 pb-10 sm:pt-12 sm:pb-14" aria-labelledby="hero-title">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-16">
          <h1 id="hero-title" class="hero-heading lg:col-span-7">Everyday Git,<br />on one map.</h1>
          <div class="max-w-md lg:col-span-5 lg:pb-2">
            <p class="text-lg leading-relaxed text-pretty muted">Oak is a cross-platform Git client for browsing history, comparing branches and staging changes. Each stop below is something it does. Pick one.</p>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a class="btn btn-primary px-4" href="#download">Download <span aria-hidden="true">↓</span></a>
              <span class="text-sm subtle">Uses your installed Git · Windows and Linux</span>
            </div>
          </div>
        </div>
      </section>

      <SystemMap />

      <section id="planned" class="site-shell mt-10" aria-labelledby="planned-title"><div class="section-block">
        <div class="grid gap-6 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 id="planned-title" class="section-heading">What may come next.</h2>
            <p class="section-copy mt-5">These are ideas on the list, not promises. They have no dates, and the order can change as I use Oak and hear from others.</p>
            <p class="mt-5 text-sm subtle">Missing something you use every day? <a class="link" href="https://github.com/benfo/oak/issues">Open an issue</a>.</p>
          </div>
          <div class="grid gap-8 lg:col-span-8">
            {plannedRows.map((row) => (
              <div class="track track-planned">
                {row.map((item) => (
                  <div class="stop"><span class="station" aria-hidden="true"></span><h3 class="stop-name">{item.name}</h3><p class="stop-text">{item.text}</p></div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div></section>

      <section id="download" class="site-shell" aria-labelledby="download-title"><div class="section-block">
        <h2 id="download-title" class="section-heading">Get Oak.</h2>
        <p class="mt-6 text-sm subtle">Version {version} · Uses your installed Git</p>
        <div class="mt-8 grid gap-10 md:grid-cols-2 lg:gap-16">
          <div class="border-t border-base-300 pt-6">
            <h3 class="text-lg font-semibold">Windows</h3>
            <p class="mt-2 text-sm subtle">Windows 11 · x64 installer</p>
            <a class="btn btn-primary mt-5" href={download}>Download for Windows <span aria-hidden="true">↓</span></a>
            <p class="mt-4 text-xs leading-relaxed muted">Requires Git on PATH.</p>
            <p class="mt-3 max-w-md text-xs leading-relaxed muted">The installer is not code-signed yet, so Windows may block the download or show a SmartScreen warning. Right-click the file, choose Properties and tick Unblock, or run <code>Unblock-File .\Oak-Setup-{version}.exe</code> in PowerShell. In SmartScreen, choose More info, then Run anyway.</p>
          </div>
          <div class="border-t border-base-300 pt-6">
            <h3 class="text-lg font-semibold">Linux</h3>
            <p class="mt-2 text-sm subtle">x64 · Debian package or AppImage</p>
            <a class="btn btn-primary mt-5" href={download}>Download for Linux <span aria-hidden="true">↓</span></a>
            <p class="mt-4 max-w-md text-xs leading-relaxed muted">Experimental. Choose the .deb or the AppImage on the release page. The Debian package is smoke-tested on Ubuntu 24.04 and installs Git as a dependency. For AppImage, install Git and mark the downloaded file as executable.</p>
          </div>
        </div>
        <p class="mt-8 text-xs muted">macOS is untested; no download is available yet.</p>
      </div></section>
    </main>
    <footer class="site-shell flex flex-wrap items-center justify-between gap-6 border-t border-base-300 py-8 text-sm muted"><p>oak · Ben Fourie</p><nav class="flex gap-6" aria-label="Footer navigation"><a class="link link-hover" href="https://github.com/benfo/oak/releases">Release notes</a><a class="link link-hover" href="https://github.com/benfo/oak/issues">Feedback</a></nav></footer>
    <ScreenshotViewer />
  </body>
</html>
