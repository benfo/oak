---
import '../styles/site.css'
import ThemeInit from '../components/ThemeInit.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import AppScreenshot from '../components/AppScreenshot.astro'
import DiffShowcase from '../components/DiffShowcase.astro'
import ScreenshotViewer from '../components/ScreenshotViewer.astro'
import { version } from '../data/release.json'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const download = 'https://github.com/benfo/oak/releases/latest'
const description = 'Oak is a cross-platform Git client. Browse history, compare branches, read diffs and stage files, hunks or selected lines. Search for actions in the command palette.'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <ThemeInit />
    <link rel="canonical" href={new URL(base + '/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/icon.svg`} />
    <meta property="og:title" content="Oak: Cross-platform Git client" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(base + '/', Astro.site)} />
    <meta property="og:image" content={new URL(base + '/oak-comparison-dark.png', Astro.site)} />
    <meta property="og:image:alt" content="Oak comparing a feature branch with main in a synthetic project." />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Oak: Cross-platform Git client</title>
  </head>
  <body>
    <a class="btn btn-primary fixed top-2 left-2 z-50 -translate-y-24 focus:translate-y-0" href="#main">Skip to content</a>
    <header class="site-shell border-b border-base-300">
      <div class="navbar min-h-20 px-0">
        <a class="oak-wordmark" href={`${base}/`} aria-label="Oak home"><img src={`${base}/icon.svg`} width="32" height="32" alt="" /><span>oak</span></a>
        <nav class="ml-auto flex items-center gap-2 sm:gap-6" aria-label="Main navigation">
          <a class="nav-link hidden sm:inline" href="#review">Review</a>
          <a class="nav-link hidden sm:inline" href="#diffs">Diffs</a>
          <a class="nav-link hidden md:inline" href="#staging">Staging</a>
          <a class="nav-link hidden md:inline" href="#commands">Commands</a>
          <a class="nav-link" href="#download">Download</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="site-shell hero-section" aria-labelledby="hero-title">
        <div class="grid gap-8 pb-12 lg:grid-cols-12 lg:items-end lg:gap-16">
          <h1 id="hero-title" class="hero-heading lg:col-span-7">A <span class="whitespace-nowrap">cross-platform</span><br /><span class="text-base-content/60">Git client.</span></h1>
          <div class="max-w-md lg:col-span-5 lg:pb-2">
            <p class="text-lg leading-relaxed text-pretty text-base-content/70">Browse history, compare branches and stage changes. Use the command palette to find actions and their shortcuts.</p>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <a class="btn btn-primary rounded-md px-4" href="#download">Download <span aria-hidden="true">↓</span></a>
              <a class="btn btn-ghost rounded-md px-3" href="#review">Explore features <span aria-hidden="true">→</span></a>
            </div>
            <p class="mt-4 text-xs text-base-content/70">Uses your installed Git · Windows and Linux</p>
          </div>
        </div>
        <figure id="showcase">
          <AppScreenshot image="oak-comparison" title="Oak comparing a feature branch with main, with commit history, changed files and a diff" priority />
          <figcaption class="preview-footer text-xs text-base-content/60"><span>Compare a branch with main without changing your working tree.</span><span>Click any screenshot to enlarge.</span></figcaption>
        </figure>
      </section>

      <section id="review" class="section-band" data-accent="orange" aria-labelledby="review-title">
        <div class="site-shell section-block border-t-0">
        <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4"><h2 id="review-title" class="section-heading">Compare branches<br />without checking out.</h2><p class="section-copy mt-6">Review what a branch introduced since it branched from its target. Select an earlier commit to review the branch at that point.</p><p class="mt-6 text-sm text-base-content/60">Your working tree stays in place while you compare.</p></div>
          <figure class="min-w-0 lg:col-span-8"><AppScreenshot image="oak-comparison" title="Oak's branch comparison with the changed files list and a diff" frameClass="relative aspect-[1636/600]" imageClass="absolute -top-[98.3%] -left-[22.2%] h-auto w-[122%] max-w-none" /><figcaption class="mt-4 flex items-center gap-2 text-xs text-base-content/60"><span class="badge badge-ghost badge-sm">Screenshot</span>Changed files and their diff, compared with the target branch.</figcaption></figure>
        </div>
        <ol class="workflow-steps">
          <li><h3>Select a target</h3><p>Compare against main, a release branch or another feature branch.</p></li>
                    <li><h3>Open a changed file</h3><p>Select a file to read its diff alongside the commit history.</p></li>
                    <li><h3>Step back to an earlier commit</h3><p>Select an earlier commit to see the branch’s changes up to that revision.</p></li>
        </ol>
        </div>
      </section>

      <section id="diffs" class="site-shell section-block" data-accent="blue" aria-labelledby="diffs-title">
        <div class="section-heading-row"><div><h2 id="diffs-title" class="section-heading">Inline or<br />side by side.</h2></div><p class="section-copy max-w-md">View additions and deletions in one column, or compare before and after in two columns. Both layouts include syntax colours and word-level change highlighting.</p></div>
        <div class="mt-10 sm:mt-14"><DiffShowcase /></div>
        <div class="mt-6 text-sm"><p class="text-base-content/60">Switch layouts in Oak with <kbd class="kbd kbd-sm">Ctrl</kbd> + <kbd class="kbd kbd-sm">Shift</kbd> + <kbd class="kbd kbd-sm">D</kbd>, keeping your place. Show more or less surrounding code with the context buttons in the diff header, or the whole file with <kbd class="kbd kbd-sm">Ctrl</kbd> + <kbd class="kbd kbd-sm">Shift</kbd> + <kbd class="kbd kbd-sm">W</kbd>.</p></div>
      </section>

      <section id="staging" class="section-band" data-accent="green" aria-labelledby="staging-title">
        <div class="site-shell section-block border-t-0">
        <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4"><h2 id="staging-title" class="section-heading">Stage files,<br />hunks or lines.</h2><p class="section-copy mt-6">Select the changes to include in a commit. A click selects exactly the line shown, and the remaining changes stay unstaged.</p><p class="mt-6 text-sm text-base-content/60">Review staged and unstaged changes beside your commit message. If you commit with nothing staged, Oak asks whether to stage the changed files first; new files are included only if you tick the box.</p></div>
          <figure class="min-w-0 lg:col-span-8"><AppScreenshot image="oak-staging" title="Oak's Changes view with two diff lines selected and a Stage lines button" frameClass="aspect-[2160/1383]" imageClass="h-full w-full object-cover object-left-top" /><figcaption class="mt-4 flex items-center gap-2 text-xs text-base-content/60"><span class="badge badge-ghost badge-sm">Screenshot</span>Two lines selected in a diff, ready to stage; the rest of the hunk stays unstaged.</figcaption></figure>
        </div>
        </div>
      </section>

      <section id="commands" class="site-shell section-block" data-accent="violet" aria-labelledby="commands-title">
        <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4"><h2 id="commands-title" class="section-heading">Find commands<br />by typing.</h2><p class="section-copy mt-6">Press <kbd class="kbd kbd-sm">Ctrl Shift P</kbd> and type part of a command name. Use the arrow keys to select a result and Enter to run it.</p><p class="mt-6 text-sm leading-relaxed text-base-content/60">The palette includes branch operations, comparisons, stash actions, diff controls, history scope (for example, only the current branch's own commits), opening a branch's pull request page and preferences. Commands show their keyboard shortcuts where available.</p></div>
          <figure class="min-w-0 lg:col-span-8"><AppScreenshot image="oak-commands" title="Oak's command palette showing matching commands and keyboard shortcuts" frameClass="relative aspect-[4/3]" imageClass="absolute -top-[8%] -left-1/2 h-auto w-[200%] max-w-none" /><figcaption class="mt-4 flex items-center gap-2 text-xs text-base-content/60"><span class="badge badge-ghost badge-sm">Screenshot</span>Search for an action without locating it in a menu.</figcaption></figure>
        </div>
      </section>

      <section id="focus" class="section-band" data-accent="teal" aria-labelledby="focus-title">
        <div class="site-shell section-block border-t-0">
        <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4"><h2 id="focus-title" class="section-heading">Give the diff<br />the whole window.</h2><p class="section-copy mt-6">Press <kbd class="kbd kbd-sm">F11</kbd> to expand the code area. Press it again, or Escape when nothing else is selected, to restore your layout, focus and pane sizes.</p><p class="mt-6 text-sm leading-relaxed text-base-content/60">While reading a diff, <kbd class="kbd kbd-sm">Alt PageUp</kbd> and <kbd class="kbd kbd-sm">Alt PageDown</kbd> move between files. The toolbar's expand button does the same as F11.</p></div>
          <div class="grid min-w-0 gap-4 sm:grid-cols-2 lg:col-span-8">
            <figure class="min-w-0"><AppScreenshot image="oak-staging" title="Oak in its standard layout, with the file list, diff and commit message" frameClass="aspect-[4/3]" imageClass="h-full w-full object-cover object-left-top" /><figcaption class="mt-4 text-xs text-base-content/60">Standard layout.</figcaption></figure>
            <figure class="min-w-0"><AppScreenshot image="oak-focus" title="Oak with the code area expanded to fill the window" frameClass="aspect-[4/3]" imageClass="h-full w-full object-cover object-left-top" /><figcaption class="mt-4 text-xs text-base-content/60">After pressing F11: the diff fills the window.</figcaption></figure>
          </div>
        </div>
        </div>
      </section>
      <section id="tree" class="site-shell section-block" data-accent="blue" aria-labelledby="tree-title">
        <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4"><h2 id="tree-title" class="section-heading">Changed files<br />as a list or a tree.</h2><p class="section-copy mt-6">Press <kbd class="kbd kbd-sm">V</kbd> in a file list or the diff, or use the button in the list's header, to group changed files by folder. It applies to Changes and to a commit's files in History, and your selection stays in place when you switch.</p></div>
          <figure class="min-w-0 lg:col-span-8"><AppScreenshot image="oak-tree" title="Oak's Changes view with files grouped by folder and a folder selected" frameClass="aspect-[2160/1383]" imageClass="h-full w-full object-cover object-left-top" /><figcaption class="mt-4 flex items-center gap-2 text-xs text-base-content/60"><span class="badge badge-ghost badge-sm">Screenshot</span>Unstaged and staged files grouped by folder, with the src/components folder selected.</figcaption></figure>
        </div>
      </section>
      <section class="section-band" data-accent="orange" aria-labelledby="details-title">
        <div class="site-shell section-block border-t-0">
        <h2 id="details-title" class="support-heading">Small behaviours that save steps.</h2>
        <div class="mt-8 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-12">
          <div><h3 class="text-lg font-medium">History scope</h3><p class="section-copy mt-3">Show only the current branch's own commits, without the default branch's history. Switch to the full ancestry, or add a target branch, from the History scope menu.</p></div>
          <div><h3 class="text-lg font-medium">Resize with the keyboard</h3><p class="section-copy mt-3">Press <kbd class="kbd kbd-sm">Shift Alt ←</kbd> <kbd class="kbd kbd-sm">→</kbd> <kbd class="kbd kbd-sm">↑</kbd> <kbd class="kbd kbd-sm">↓</kbd> to move the divider of the pane you are in. Dragging a divider still works.</p></div>
          <div><h3 class="text-lg font-medium">File history</h3><p class="section-copy mt-3">Choose "Show file history" from a file's menu, or from the command palette, to filter the History graph to the commits that touched that file. Stepping through them shows only that file's diff.</p></div>
          <div><h3 class="text-lg font-medium">Conflicts open in your merge tool</h3><p class="section-copy mt-3">When a merge stops with conflicts, Oak switches to Changes and shows a banner. Open the conflicted files one after another in the merge tool set in Preferences. Marking a file resolved warns you if conflict markers remain.</p></div>
        </div>
        </div>
      </section>
      <section class="site-shell section-block" aria-label="Navigation and Git setup">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-24">
          <div><h2 class="support-heading">Navigate lists, diffs and menus.</h2><p class="section-copy mt-4">Move between history, files and diffs using the keyboard. Tab steps through the controls inside a pane, such as the buttons in a file list. F6 switches panes. Search lists with / or Ctrl+F. Optional h/j/k/l keys work alongside the arrows in lists, diffs and menus.</p><dl class="shortcut-strip"><div><dt>Find</dt><dd><kbd class="kbd kbd-sm">Ctrl F</kbd></dd></div><div><dt>Shortcuts</dt><dd><kbd class="kbd kbd-sm">Ctrl /</kbd></dd></div><div><dt>Switch panes</dt><dd><kbd class="kbd kbd-sm">F6</kbd></dd></div><div><dt>Expand / restore</dt><dd><kbd class="kbd kbd-sm">F11</kbd></dd></div></dl></div>
          <div><h2 class="support-heading">Uses your installed Git.</h2><p class="section-copy mt-4">Oak runs the Git CLI. It uses your existing credentials, configuration, hooks and Git LFS setup.</p><p class="mt-6 text-sm leading-relaxed text-base-content/70">The working tree refreshes automatically when local files change and when you return to the window. Fetch checks for changes on the remote.</p></div>
        </div>
      </section>

      <section id="planned" class="section-band" data-accent="violet" aria-labelledby="planned-title">
        <div class="site-shell section-block border-t-0">
        <h2 id="planned-title" class="support-heading">What may come next.</h2>
        <p class="section-copy mt-4 max-w-xl">These are ideas on the list, not promises. They have no dates, and the order can change as I use Oak and hear from others.</p>
        <div class="mt-8 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-12">
          <div><h3 class="text-lg font-medium">Smoother conflicts</h3><p class="section-copy mt-3">Say which side is ours and theirs, handle modify and delete conflicts, and bring Pull and Rebase conflicts into the same flow.</p></div>
          <div><h3 class="text-lg font-medium">Interactive rebase</h3><p class="section-copy mt-3">Reorder, squash, edit and drop commits from the history graph.</p></div>
          <div><h3 class="text-lg font-medium">Blame</h3><p class="section-copy mt-3">Find who last changed a line and jump to the commit that did.</p></div>
          <div><h3 class="text-lg font-medium">Pull request review</h3><p class="section-copy mt-3">Fetch a pull request's branches and open the comparison in Oak. Comments and approvals would stay on the provider's website at first.</p></div>
          <div><h3 class="text-lg font-medium">Diff readability</h3><p class="section-copy mt-3">Hide whitespace and line-ending differences, and fold long unchanged regions so substantive edits stand out.</p></div>
          <div><h3 class="text-lg font-medium">Open and preview more files</h3><p class="section-copy mt-3">Preview images, PDFs and other safe files, and open anything else in its default app or show it in its folder.</p></div>
          <div><h3 class="text-lg font-medium">Git command log</h3><p class="section-copy mt-3">A list of every command Oak ran, with its output.</p></div>
          <div><h3 class="text-lg font-medium">Signed installer</h3><p class="section-copy mt-3">Code-sign the Windows installer so it no longer needs unblocking.</p></div>
        </div>
        <p class="mt-8 text-sm text-base-content/60">Missing something you use every day? <a class="link" href="https://github.com/benfo/oak/issues">Open an issue</a>.</p>
        </div>
      </section>

      <section id="download" class="site-shell section-block" aria-labelledby="download-title">
        <h2 id="download-title" class="section-heading">Get Oak.</h2>
        <p class="mt-6 text-sm text-base-content/60">Version {version} · Uses your installed Git</p>
        <div class="mt-8 grid gap-10 md:grid-cols-2 lg:gap-16">
          <div class="border-t border-base-300 pt-6">
            <h3 class="text-lg font-medium">Windows</h3>
            <p class="mt-2 text-sm text-base-content/60">Windows 11 · x64 installer</p>
            <a class="btn btn-primary mt-5 rounded-md" href={download}>Download for Windows <span aria-hidden="true">↓</span></a>
            <p class="mt-4 text-xs leading-relaxed text-base-content/70">Requires Git on PATH.</p>
            <p class="mt-3 max-w-md text-xs leading-relaxed text-base-content/70">The installer is not code-signed yet, so Windows may block the download or show a SmartScreen warning. Right-click the file, choose Properties and tick Unblock, or run <code>Unblock-File .\Oak-Setup-{version}.exe</code> in PowerShell. In SmartScreen, choose More info, then Run anyway.</p>
          </div>
          <div class="border-t border-base-300 pt-6">
            <h3 class="text-lg font-medium">Linux</h3>
            <p class="mt-2 text-sm text-base-content/60">x64 · Debian package or AppImage</p>
            <a class="btn btn-primary mt-5 rounded-md" href={download}>Download for Linux <span aria-hidden="true">↓</span></a>
            <p class="mt-4 max-w-md text-xs leading-relaxed text-base-content/70">Experimental. Choose the .deb or the AppImage on the release page. The Debian package is smoke-tested on Ubuntu 24.04 and installs Git as a dependency. For AppImage, install Git and mark the downloaded file as executable.</p>
          </div>
        </div>
        <p class="mt-8 text-xs text-base-content/70">macOS is untested; no download is available yet.</p>
      </section>
    </main>
    <footer class="site-shell flex flex-wrap items-center justify-between gap-6 border-t border-base-300 py-8 text-sm text-base-content/70"><p>oak · Ben Fourie</p><nav class="flex gap-6" aria-label="Footer navigation"><a class="link link-hover" href="https://github.com/benfo/oak/releases">Release notes</a><a class="link link-hover" href="https://github.com/benfo/oak/issues">Feedback</a></nav></footer>
    <ScreenshotViewer />
  </body>
</html>
